VITE_KAKAO_MAP_APP_KEY=
# 개발 중 절대 주소를 설정하면 Vite의 /api 프록시로 연결합니다.
# 운영에서는 설정된 서버에 직접 요청하므로 쿠키·CORS 구성이 필요합니다.
# 개발 환경에서 API 주소가 비어 있으면 각 화면에서 목업을 사용합니다.
# API 주소가 있으면 실제 API를 조회합니다. 개발용 개별 홈 미리보기: /?preview=home
# 매칭 대기 화면과 채팅방에 머무는 동안에만 목업 자동 동작이 실행됩니다.
# 개발 서버 예: http://18.225.251.151:8080
# 인증 모듈은 개발 환경에서 주소가 비어 있으면 목업을 사용합니다.
# 운영 빌드에서 비워두면 현재 도메인의 /api/v1 경로를 사용합니다.
VITE_API_BASE_URL=
